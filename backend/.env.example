MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/tcalendar?retryWrites=true&w=majority
JWT_SECRET=pon-aca-un-texto-largo-y-aleatorio
CLIENT_URL=https://tu-frontend.vercel.app
PORT=5000

# Administradores (usuarios ya registrados, separados por coma): pueden restablecer contraseñas desde "Mi cuenta".
ADMIN_USERNAMES=tu_usuario

# Recordatorios push (opcionales). Generá las claves con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
# Clave para que el cron externo llame a POST /push/reminders/run (cabecera x-cron-key)
CRON_KEY=otro-texto-largo-y-aleatorio
